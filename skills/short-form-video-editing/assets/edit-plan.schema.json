{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIA short-form edit plan",
  "description": "The shape of edit_plan.json as the video workflow writes it. The source, asset_id and effect fields are not optional extras: a plan that omits asset_id on a shot taken from the material renders nothing, and the workflow rejects it.",
  "type": "object",
  "required": ["project_id", "platform", "aspect_ratio", "beats"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "platform": { "type": "string", "minLength": 1 },
    "aspect_ratio": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "purpose", "visual", "source", "effect"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "purpose": { "type": "string", "enum": ["hook", "evidence", "conclusion", "cta"] },
          "visual": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["asset", "generate", "animate"],
            "description": "asset uses a supplied file; animate turns one supplied image into motion; generate makes a new shot. The latter two are billed per second of Veo."
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "description": "Which supplied asset this shot uses. Required for source=asset and source=animate; absent for source=generate."
          },
          "generate_prompt": { "type": "string" },
          "effect": { "type": "string", "enum": ["zoom_in", "zoom_out", "pan_left", "pan_right"] },
          "copy": { "type": "string", "description": "Narration. Roughly 4 Chinese characters per second must fit inside the beat." },
          "caption": { "type": "string", "description": "On-screen text, shorter than the narration." },
          "pending": {
            "type": "boolean",
            "description": "Something the user must still supply or approve — missing material, uncleared rights, a fact to verify. Not a defect in the render."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "source": { "const": "asset" } }, "required": ["source"] },
            "then": { "required": ["asset_id"] }
          },
          {
            "if": { "properties": { "source": { "const": "animate" } }, "required": ["source"] },
            "then": { "required": ["asset_id", "generate_prompt"] }
          },
          {
            "if": { "properties": { "source": { "const": "generate" } }, "required": ["source"] },
            "then": { "required": ["generate_prompt"] }
          }
        ]
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
